{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Exec(git)",
      "Exec(python)",
      "Exec(python3)",
      "Exec(pytest)",
      "Exec(npm)",
      "Exec(npx)",
      "Exec(node)",
      "Exec(pre-commit)",
      "Exec(pip)",
      "Exec(pip3)",
      "Exec(poetry)",
      "Exec(make)",
      "Exec(docker)",
      "Exec(docker-compose)",
      "mcp__github__*"
    ],
    "deny": [
      "Exec(sudo)",
      "Exec(rm -rf)",
      "Exec(rm)",
      "Exec(rmdir)",
      "mcp__github__delete_repo"
    ]
  },
  "read_config_from": {
    "cursor": true,
    "windsurf": true,
    "claude": true
  }
}